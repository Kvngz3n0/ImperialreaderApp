<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="16dp" android:paddingEnd="8dp" android:paddingTop="10dp" android:paddingBottom="10dp"
    android:background="?attr/selectableItemBackground">
    <LinearLayout
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/chTitle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="2" android:ellipsize="end"
            android:textColor="@color/on_surface" android:textSize="15sp"/>
        <TextView android:id="@+id/chSub"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end"
            android:textColor="@color/on_surface_variant" android:textSize="12sp"/>
    </LinearLayout>
    <FrameLayout android:id="@+id/chDlFrame"
        android:layout_width="44dp" android:layout_height="44dp">
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/chDlProgress"
            android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center"
            android:visibility="gone"
            app:indicatorSize="26dp" app:trackThickness="3dp"/>
        <ImageView android:id="@+id/chDlIcon"
            android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center"
            android:contentDescription="download"/>
    </FrameLayout>
</LinearLayout>
